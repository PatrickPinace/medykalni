---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getEntry } from 'astro:content';
import { formatDateRangePL } from '../../utils/dateFormatters';

const courseData = await getEntry('courses', 'prowadzenie-ciazy');
if (!courseData) throw new Error('Course data not found');

const course = courseData.data;
const activeEdition = course.editions.find(e => e.active);
if (!activeEdition) throw new Error('No active edition found');

const pricing = course.pricing;
const place = course.place;
const edition = activeEdition;
const GOOGLE_FORM_URL = edition.signupUrl;

const baseUrl = import.meta.env.BASE_URL;

const formatPrice = (n: number) => n.toLocaleString('pl-PL') + ' zł';

const modules = [
  {
    id: 'I',
    title: 'Podstawy prowadzenia ciąży przez położną',
    sub: null,
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    items: [
      'Wprowadzenie do roli położnej w prowadzeniu ciąży',
      'Obowiązki, zakres kompetencji i odpowiedzialność prawna',
      'Dokumentacja medyczna i standardy prowadzenia zapisów',
      'Praktyczne przykłady przypadków i analiza dokumentacji',
    ],
  },
  {
    id: 'II',
    title: 'Prowadzenie ciąży w praktyce',
    sub: 'Symulacja wizyty w gabinecie położnej',
    icon: 'M19 14l-7 7m0 0l-7-7m7 7V3',
    items: [
      'Wywiad medyczny i ocena stanu pacjentki',
      'Badania fizykalne i interpretacja wyników',
      'Budowanie relacji i komunikacja z pacjentką',
      'Pokazowe badanie USG z omówieniem wyników',
      'Ćwiczenia praktyczne w małych grupach',
    ],
  },
  {
    id: 'III',
    title: 'Kinesiotaping w ciąży',
    sub: 'Zajęcia: mgr Katarzyna Soja-Chydzińska',
    icon: 'M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121',
    items: [
      'Zasady działania i wskazania w ciąży',
      'Praktyczne techniki aplikacji w łagodzeniu dolegliwości',
      'Omówienie przypadków i indywidualne konsultacje',
    ],
  },
  {
    id: 'IV',
    title: 'Suplementacja, odżywianie i interpretacja badań',
    sub: '4 spotkania online: dr Barbara Piekło',
    icon: 'M3 3v18h18M18.7 8l-5.1 5.2-2.8-2.7L7 14.3',
    items: [
      'Dieta i suplementacja w ciąży — teoria i praktyka',
      'Analiza wyników badań laboratoryjnych i wnioski',
      'Dostęp do nagrań wideo ze wszystkich spotkań',
    ],
  },
  {
    id: 'V',
    title: 'Mentoring i wsparcie w prowadzeniu ciąży',
    sub: null,
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    items: [
      'Wsparcie w pierwszych krokach zawodowych położnej',
      'Dostęp do zamkniętej grupy uczestniczek i ekspertów',
      'Spotkania online przez <b>12 miesięcy</b> + konsultacje trudnych przypadków',
    ],
  },
  {
    id: 'VI',
    title: 'Kontraktowanie z NFZ i wsparcie prawno-biznesowe',
    sub: null,
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    items: [
      'Proces kontraktowania świadczeń prowadzenia ciąży w NFZ',
      'Wsparcie konsultanta biznesowego i prawnika przy kontrakcie',
      'Praktyczne wskazówki dotyczące negocjacji i formalności',
    ],
  },
];

const experts = [
  {
    name: 'mgr Anna Plaskota-Gładosz',
    role: 'Położna / CDL',
    desc: 'Położna z ponad 10-letnim doświadczeniem, specjalistka w prowadzeniu ciąży fizjologicznej.',
    photo: 'anna-plaskota-gladosz.jpg',
    initials: null,
  },
  {
    name: 'mgr Kinga Niećko',
    role: 'Położna / NFZ',
    desc: 'Jako jedna z pierwszych w Małopolsce prowadzi ciążę fizjologiczną w ramach umowy z NFZ.',
    photo: null,
    initials: 'KN',
  },
  {
    name: 'dr Barbara Piekło',
    role: 'Dietetyk kliniczny',
    desc: 'Dietetyk kliniczny i psychodietetyk — suplementacja oraz interpretacja badań w ciąży.',
    photo: null,
    initials: 'BP',
  },
  {
    name: 'mgr Katarzyna Soja-Chydzińska',
    role: 'Fizjoterapeutka',
    desc: 'Fizjoterapeutka uroginekologiczna — ekspertka w kinesiotapingu w ciąży.',
    photo: null,
    initials: 'KS',
  },
];
---

<Layout
  title={`${course.title} — Kurs | Medykalni`}
  description={`Kompleksowy kurs modułowy dla położnych. Szkolenie w ${place.city}, ${formatDateRangePL(edition.onsite.start, edition.onsite.end, 'long')}.`}
>
  <TopBar />
  <Header />

  <main>
    <!-- Breadcrumb -->
    <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
      <div class="text-[14px] text-fg-soft pt-9">
        <a href={baseUrl} class="hover:text-navy transition-colors">Medykalni</a>
        <span class="mx-1">·</span>
        <a href={`${baseUrl}szkolenia`} class="hover:text-navy transition-colors">Szkolenia</a>
        <span class="mx-1">·</span>
        <span class="text-clay">{course.title}</span>
      </div>
    </div>

    <!-- HERO -->
    <section class="pt-8 pb-20 md:pb-24">
      <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
        <div class="grid md:grid-cols-[1.05fr_0.95fr] gap-10 md:gap-15 items-center">
          <div>
            <div class="flex gap-2 mb-6 flex-wrap">
              <span class="font-sans font-semibold text-[12.5px] px-3 py-1 rounded-full bg-ivory-2 text-teal-dark">dla położnych</span>
              <span class="font-sans font-semibold text-[12.5px] px-3 py-1 rounded-full bg-ivory-2 text-teal-dark">stacjonarne + online</span>
              <span class="font-sans font-semibold text-[12.5px] px-3 py-1 rounded-full bg-ivory-2 text-teal-dark">certyfikat</span>
            </div>
            <h1 class="font-heading text-[40px] md:text-[52px] lg:text-[58px] leading-[1.1] tracking-tight mb-6 text-ink">
              Prowadź ciążę pacjentek z <em>pewnością</em> i profesjonalizmem
            </h1>
            <p class="text-[18px] md:text-[19px] leading-[1.6] max-w-[32em] mb-8 text-fg">
              Kompleksowy kurs modułowy dla położnych, które chcą prowadzić ciąże fizjologiczne we własnej praktyce — zgodnie z aktualnymi standardami i przepisami prawa.
            </p>
            <div class="flex flex-wrap gap-3.5">
              <a href="#pakiety" class="btn btn-clay">Zapisz się na kurs</a>
              <a href="#pakiety" class="btn btn-ghost">Zobacz pakiety</a>
            </div>

            <div class="flex gap-8 mt-10 pt-7 border-t border-line">
              <div>
                <div class="font-heading text-[26px] md:text-[30px] text-navy leading-none whitespace-nowrap">6</div>
                <div class="text-[13px] text-fg-soft mt-2">modułów<br>od podstaw po NFZ</div>
              </div>
              <div>
                <div class="font-heading text-[26px] md:text-[30px] text-navy leading-none whitespace-nowrap">4</div>
                <div class="text-[13px] text-fg-soft mt-2">ekspertów<br>praktyków</div>
              </div>
              <div>
                <div class="font-heading text-[26px] md:text-[30px] text-navy leading-none whitespace-nowrap">12 mc</div>
                <div class="text-[13px] text-fg-soft mt-2">mentoringu<br>w pakiecie</div>
              </div>
            </div>
          </div>

          <!-- Right: photo + blob + price badge -->
          <div class="relative">
            <div
              class="absolute -right-6 -bottom-6 w-[78%] h-[62%] bg-clay-soft z-0"
              style="border-radius:18px 18px 18px 120px;"
            ></div>
            <div
              class="relative z-10 overflow-hidden shadow-[0_24px_50px_rgba(35,32,28,0.13)]"
              style="aspect-ratio:4/5;border-radius:200px 200px 18px 18px;"
            >
              <img
                src={`${baseUrl}images/team/anna-plaskota-gladosz.jpg`}
                alt="Położna prowadząca kurs"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute -left-4 md:-left-7 bottom-11 z-20 bg-paper rounded-2xl px-5 py-4 shadow-[0_10px_26px_rgba(35,32,28,0.09)]">
              <div class="text-[12px] text-fg-soft">już od</div>
              <div class="font-heading text-[24px] md:text-[26px] text-navy leading-tight whitespace-nowrap">{formatPrice(pricing.basic)}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- INTRO CARD -->
    <section class="py-20 md:py-24 bg-paper">
      <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
        <div class="max-w-[880px] mx-auto bg-ivory border border-line rounded-[24px] p-9 md:p-14 grid md:grid-cols-[auto_1fr] gap-8 items-start">
          <div class="w-[58px] h-[58px] rounded-[16px] bg-clay-soft text-clay-hover flex items-center justify-center shrink-0">
            <svg class="w-[30px] h-[30px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 14l9-5-9-5-9 5 9 5z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 14l6.16-3.42a12 12 0 01.84 4.42 12 12 0 01-7 1 12 12 0 01-7-1 12 12 0 01.84-4.42L12 14z" />
            </svg>
          </div>
          <div>
            <h2 class="font-heading text-[24px] md:text-[30px] mb-5 text-ink leading-tight">
              Dla położnych, które chcą poszerzyć swoje kompetencje
            </h2>
            <p class="text-[16px] md:text-[17px] leading-[1.65] mb-3.5 text-fg">
              Ten kurs został stworzony specjalnie dla położnych, które pragną w swojej praktyce zawodowej prowadzić ciąże pacjentek zgodnie z aktualnymi standardami i przepisami prawa.
            </p>
            <p class="text-[16px] md:text-[17px] leading-[1.65] text-fg">
              Poznasz nie tylko teorię, ale też praktyczne rozwiązania, które od razu możesz zastosować w pracy.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROGRAM / MODULES -->
    <section id="program" class="py-20 md:py-24">
      <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
        <div class="text-center max-w-[720px] mx-auto mb-14">
          <div class="eyebrow center">Program kursu</div>
          <h2 class="font-heading text-[32px] md:text-[44px] mt-4 leading-tight tracking-tight text-ink">
            Sześć modułów — od podstaw do własnego kontraktu
          </h2>
        </div>

        <div class="max-w-[940px] mx-auto">
          {modules.map((mod, i) => (
            <div class={`grid md:grid-cols-[88px_1fr] gap-4 md:gap-8 py-10 border-t border-line ${i === modules.length - 1 ? 'border-b' : ''}`}>
              <div>
                <div class="font-heading text-[15px] text-clay tracking-wider uppercase mb-2.5">Moduł {mod.id}</div>
                <div class="w-[54px] h-[54px] rounded-[15px] bg-ivory-2 text-teal-dark flex items-center justify-center">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d={mod.icon} />
                  </svg>
                </div>
              </div>
              <div>
                <h3 class="font-heading text-[22px] md:text-[25px] mb-2 text-ink">{mod.title}</h3>
                {mod.sub && (
                  <p class="text-[15.5px] text-fg-soft mb-4 italic font-heading">{mod.sub}</p>
                )}
                <ul class="space-y-2.5">
                  {mod.items.map((item) => (
                    <li class="flex gap-3 items-start text-[15px] md:text-[16px] leading-[1.5] text-fg-1">
                      <svg class="w-[19px] h-[19px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section id="pakiety" class="py-20 md:py-24 bg-ivory-2">
      <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
        <div class="text-center max-w-[720px] mx-auto mb-14">
          <div class="eyebrow center">Pakiety</div>
          <h2 class="font-heading text-[32px] md:text-[44px] mt-4 leading-tight tracking-tight text-ink">
            Wybierz pakiet dla siebie
          </h2>
          <p class="text-[17px] md:text-[19px] leading-[1.6] mt-4 text-fg">
            Trzy poziomy zaangażowania — od jednego dnia szkolenia po pełne wsparcie z kontraktem NFZ.
          </p>
        </div>

        <div id="zapisy" class="grid md:grid-cols-3 gap-6 items-start">
          <!-- Basic -->
          <div class="bg-paper border border-line rounded-[22px] p-9 flex flex-col transition-all duration-250 hover:shadow-[0_10px_26px_rgba(35,32,28,0.09)]">
            <div class="font-heading text-[24px] text-ink mb-1.5">Pakiet Podstawowy</div>
            <div class="font-heading text-[36px] md:text-[42px] text-navy leading-none mb-1.5">{formatPrice(pricing.basic)}</div>
            <div class="text-[13.5px] text-fg-soft mb-6 pb-5 border-b border-line">Moduł I</div>
            <ul class="space-y-3.5 mb-7 flex-grow">
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>1 dzień szkolenia stacjonarnego w {place.city} — {formatDateRangePL(edition.onsite.start, edition.onsite.start, 'short')}</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Obiad i przerwy kawowe</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Materiały szkoleniowe</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Certyfikat ukończenia</span>
              </li>
            </ul>
            <a href={GOOGLE_FORM_URL} target="_blank" rel="noopener" class="btn btn-ghost w-full">Wybierz pakiet</a>
          </div>

          <!-- Standard (featured) -->
          <div class="bg-paper border-[1.5px] border-clay rounded-[22px] p-9 flex flex-col relative shadow-[0_24px_50px_rgba(35,32,28,0.13)]">
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-clay text-white font-sans font-semibold text-[12.5px] tracking-wide px-4.5 py-1.5 rounded-full whitespace-nowrap shadow-[0_10px_26px_rgba(35,32,28,0.09)]">
              ★ Najpopularniejszy
            </div>
            <div class="font-heading text-[24px] text-ink mb-1.5">Pakiet Standard</div>
            <div class="font-heading text-[36px] md:text-[42px] text-navy leading-none mb-1.5">{formatPrice(pricing.standard)}</div>
            <div class="text-[13.5px] text-fg-soft mb-6 pb-5 border-b border-line">Pakiet Podstawowy + Moduły II–V</div>
            <ul class="space-y-3.5 mb-7 flex-grow">
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] font-semibold text-ink">
                <svg class="w-[18px] h-[18px] text-clay shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Wszystko z Pakietu Podstawowego</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Prowadzenie ciąży w praktyce, USG, kinesiotaping, suplementacja, mentoring online</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Szkolenia stacjonarne {formatDateRangePL(edition.onsite.start, edition.onsite.end, 'short')} w {place.city} + szkolenie online</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>2 obiady · taśmy do kinesiotapingu</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Możliwość bezpłatnego noclegu</span>
              </li>
            </ul>
            <a href={GOOGLE_FORM_URL} target="_blank" rel="noopener" class="btn btn-clay w-full">Wybierz pakiet</a>
          </div>

          <!-- Premium -->
          <div class="bg-paper border border-line rounded-[22px] p-9 flex flex-col transition-all duration-250 hover:shadow-[0_10px_26px_rgba(35,32,28,0.09)]">
            <div class="font-heading text-[24px] text-ink mb-1.5">Pakiet Premium</div>
            <div class="font-heading text-[36px] md:text-[42px] text-navy leading-none mb-1.5">{formatPrice(pricing.premium)}</div>
            <div class="text-[13.5px] text-fg-soft mb-6 pb-5 border-b border-line">Pakiet Standard + Moduł VI</div>
            <ul class="space-y-3.5 mb-7 flex-grow">
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] font-semibold text-ink">
                <svg class="w-[18px] h-[18px] text-clay shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Wszystko z Pakietu Standard</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Kontraktowanie z NFZ, wsparcie konsultanta biznesowego i prawnika</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Materiały do pobrania</span>
              </li>
              <li class="flex gap-3 items-start text-[14.5px] leading-[1.5] text-fg-1">
                <svg class="w-[18px] h-[18px] text-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Indywidualne konsultacje 1:1</span>
              </li>
            </ul>
            <a href={GOOGLE_FORM_URL} target="_blank" rel="noopener" class="btn btn-ghost w-full">Wybierz pakiet</a>
          </div>
        </div>
      </div>
    </section>

    <!-- EXPERTS -->
    <section class="py-20 md:py-24 bg-paper">
      <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
        <div class="text-center max-w-[720px] mx-auto mb-14">
          <div class="eyebrow center">Eksperci</div>
          <h2 class="font-heading text-[32px] md:text-[44px] mt-4 leading-tight tracking-tight text-ink">
            Poznaj naszych prowadzących
          </h2>
          <p class="text-[17px] md:text-[19px] leading-[1.6] mt-4 text-fg">
            Praktycy ochrony zdrowia, którzy na co dzień pracują z pacjentkami.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {experts.map((expert) => (
            <div class="text-center">
              <div class="w-[130px] h-[130px] rounded-full mx-auto mb-5 overflow-hidden border-[3px] border-clay-soft bg-clay-soft flex items-center justify-center">
                {expert.photo ? (
                  <img src={`${baseUrl}images/team/${expert.photo}`} alt={expert.name} class="w-full h-full object-cover" />
                ) : (
                  <span class="font-heading text-[38px] text-clay-hover">{expert.initials}</span>
                )}
              </div>
              <h3 class="font-heading text-[19px] mb-1 text-ink">{expert.name}</h3>
              <div class="font-sans text-[13px] font-semibold text-clay mb-2.5">{expert.role}</div>
              <p class="text-[14.5px] leading-[1.55] text-fg">{expert.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="py-20 md:py-24 bg-clay text-white">
      <div class="max-w-[860px] mx-auto px-6 lg:px-12 text-center">
        <h2 class="font-heading text-[32px] md:text-[44px] mb-5 text-white leading-tight tracking-tight">
          Nie czekaj — poszerz swoje kompetencje
        </h2>
        <p class="text-[18px] md:text-[19px] text-white/90 mb-8 leading-relaxed max-w-[40em] mx-auto">
          Dołącz do grona wykwalifikowanych położnych, które z sukcesem prowadzą ciąże w swojej praktyce zawodowej.
        </p>
        <div class="flex flex-col sm:flex-row gap-3.5 justify-center">
          <a href={GOOGLE_FORM_URL} target="_blank" rel="noopener" class="btn btn-white">Zapisz się teraz</a>
          <a href="tel:+48881489851" class="btn btn-outline-w">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Zadzwoń i zapytaj
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
