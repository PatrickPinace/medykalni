---
// Process — navy bg, clay numbers, hairline tops
const steps = [
  {
    n: '01',
    title: 'Rozmowa wstępna',
    desc: 'Poznajemy Twoje potrzeby i określamy obszary wsparcia.',
  },
  {
    n: '02',
    title: 'Dobór rozwiązania',
    desc: 'Proponujemy rozwiązanie dostosowane do Twoich celów.',
  },
  {
    n: '03',
    title: 'Szkolenie / wdrożenie',
    desc: 'Realizujemy program lub wdrażamy procesy w placówce.',
  },
  {
    n: '04',
    title: 'Opieka po szkoleniu',
    desc: 'Wspieramy w praktycznym zastosowaniu wiedzy.',
  },
];
---

<section class="py-20 md:py-24 bg-navy text-white">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
    <div class="text-center max-w-[680px] mx-auto mb-14">
      <div class="eyebrow center" style="color:#9fd3d5;">Współpraca</div>
      <h2 class="font-heading text-[32px] md:text-[44px] mt-4 leading-tight tracking-tight text-white">
        Przejrzysty proces, krok po kroku
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-7">
      {steps.map((step) => (
        <div class="pt-6 border-t-2 border-white/20">
          <div class="font-heading text-[40px] text-clay leading-none mb-4">{step.n}</div>
          <h3 class="font-heading text-[21px] text-white mb-3">{step.title}</h3>
          <p class="text-[14.5px] leading-[1.55] text-white/75">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
