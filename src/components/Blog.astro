---
// Blog — editorial posts z placeholder thumbnails
const posts = [
  {
    date: '15 stycznia 2026',
    title: 'Jak skutecznie zarządzać zespołem medycznym',
    desc: 'Praktyczne wskazówki dla właścicieli placówek dotyczące budowania efektywnego zespołu.',
  },
  {
    date: '8 stycznia 2026',
    title: 'Komunikacja z pacjentem w trudnych sytuacjach',
    desc: 'Jak rozmawiać, gdy diagnoza jest niepomyślna lub pojawia się konflikt.',
  },
  {
    date: '2 stycznia 2026',
    title: 'Standardy pracy — dlaczego są kluczowe',
    desc: 'Jak wdrożyć procedury w placówce, by poprawić jakość i bezpieczeństwo.',
  },
];
---

<section id="wiedza" class="py-20 md:py-24 bg-paper">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
    <div class="text-center max-w-[680px] mx-auto mb-14">
      <div class="eyebrow center">Wiedza</div>
      <h2 class="font-heading text-[32px] md:text-[44px] mt-4 leading-tight tracking-tight text-ink">
        Artykuły i materiały eksperckie
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <a href="#" class="group block">
          <div
            class="rounded-[16px] flex items-center justify-center text-clay mb-5"
            style="aspect-ratio:3/2;background:linear-gradient(160deg,#F4ECE1,#EBD7CD);"
          >
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div class="text-[13px] text-fg-soft mb-2">{post.date}</div>
          <h3 class="font-heading text-[20px] leading-[1.3] mb-2.5 text-ink">{post.title}</h3>
          <p class="text-[15px] leading-[1.55] mb-3.5 text-fg">{post.desc}</p>
          <span class="go text-[14.5px]">
            Czytaj więcej
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
