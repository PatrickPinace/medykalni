---
// Footer — dark ink bg z ivory accent
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="bg-bg-dark text-white py-16 pb-9">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
    <div class="grid md:grid-cols-[1.5fr_1fr_1fr_1fr] gap-10 mb-9">
      <!-- Logo + description -->
      <div>
        <img
          src={`${baseUrl}images/medykalni-logo.png`}
          alt="Medykalni"
          class="h-[38px] mb-4"
          style="filter:brightness(0) invert(1);"
        />
        <p class="text-white/60 text-[14px] leading-[1.6]">
          Szkolenia i konsultacje dla personelu medycznego i właścicieli placówek prowadzone przez praktyków ochrony zdrowia.
        </p>
      </div>

      <!-- Kontakt -->
      <div>
        <h4 class="font-heading text-[18px] mb-4 text-white">Kontakt</h4>
        <a href="tel:+48881489851" class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          +48 881 489 851
        </a>
        <a href="mailto:kontakt@medykalni.pl" class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          kontakt@medykalni.pl
        </a>
        <span class="block text-white/60 text-[14px]">
          Mielec, woj. Podkarpackie
        </span>
      </div>

      <!-- Szybkie linki -->
      <div>
        <h4 class="font-heading text-[18px] mb-4 text-white">Szybkie linki</h4>
        <a href={`${baseUrl}szkolenia`} class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          Szkolenia
        </a>
        <a href={`${baseUrl}projekty/polozna-na-swoim`} class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          Położna na swoim
        </a>
        <a href={`${baseUrl}projekty/mastermind`} class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          Grupy mastermind
        </a>
        <a href={`${baseUrl}projekty/rekrutacja`} class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          Rekrutacja
        </a>
      </div>

      <!-- Informacje -->
      <div>
        <h4 class="font-heading text-[18px] mb-4 text-white">Informacje</h4>
        <a href="#" class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          Polityka prywatności
        </a>
        <a href="#" class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          RODO
        </a>
        <a href="#" class="block text-white/60 text-[14px] mb-2 hover:text-clay-soft transition-colors">
          Regulamin
        </a>
      </div>
    </div>

    <div class="border-t border-white/10 pt-7 flex flex-wrap justify-between gap-2.5 text-white/55 text-[13.5px]">
      <span>&copy; 2026 Medykalni by Medi3. Wszelkie prawa zastrzeżone.</span>
      <span>Projekt: Medykalni Team</span>
    </div>
  </div>
</footer>
