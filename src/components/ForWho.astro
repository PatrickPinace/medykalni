---
// "Dla kogo" — editorial numbered rows z hairline separators
const baseUrl = import.meta.env.BASE_URL;

const rows = [
  {
    idx: '01',
    title: 'Położne',
    desc: 'Kompleksowy kurs „Prowadzenie ciąży przez położną" — od diagnozy do porodu.',
    href: `${baseUrl}szkolenia/prowadzenie-ciazy-przez-polozna`,
    cta: 'Zobacz kurs',
  },
  {
    idx: '02',
    title: 'Położna na swoim',
    desc: 'Program wsparcia dla położnych prowadzących własną praktykę.',
    href: `${baseUrl}projekty/polozna-na-swoim`,
    cta: 'Zobacz program',
  },
  {
    idx: '03',
    title: 'Placówki medyczne',
    desc: 'Kompleksowa pomoc rekrutacyjna dla klinik, gabinetów i szpitali.',
    href: `${baseUrl}dla-placowek/rekrutacja`,
    cta: 'Zobacz ofertę',
  },
];
---

<section id="dla-kogo" class="py-20 md:py-24 bg-paper">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
    <div class="max-w-[560px] mb-12">
      <div class="eyebrow">Dla kogo</div>
      <h2 class="font-heading text-[32px] md:text-[42px] mt-4 leading-tight tracking-tight text-ink">
        Wspieramy położne i placówki medyczne
      </h2>
    </div>

    <div>
      {rows.map((row, i) => (
        <a
          href={row.href}
          class={`group grid grid-cols-[64px_1fr_auto] gap-6 md:gap-8 items-center py-8 border-t border-line transition-colors ${i === rows.length - 1 ? 'border-b' : ''}`}
        >
          <span class="font-heading text-[30px] text-clay">{row.idx}</span>
          <div>
            <h3 class="font-heading text-[20px] md:text-[25px] mb-2 text-ink">{row.title}</h3>
            <p class="text-[15px] md:text-[16.5px] leading-relaxed max-w-[46em] text-fg">{row.desc}</p>
          </div>
          <span class="go whitespace-nowrap hidden sm:inline-flex">
            {row.cta}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
