---
// Authority — zespół, editorial z łukami na portretach
const baseUrl = import.meta.env.BASE_URL;

const team = [
  {
    name: 'Anna Plaskota-Gładosz',
    role: 'Położna / CDL',
    desc: 'Ponad 10 lat doświadczenia, specjalistka w prowadzeniu ciąży fizjologicznej.',
    photo: 'anna-plaskota-gladosz.jpg',
    objectPosition: 'center',
  },
  {
    name: 'Anna Buczek',
    role: 'Położna',
    desc: 'Edukacja położnych i zarządzanie projektami szkoleniowymi.',
    photo: 'anna-buczek.jpg',
    objectPosition: 'center 30%',
  },
  {
    name: 'Magdalena Golba',
    role: 'Położna',
    desc: 'Szkolenia medyczne i rozwój kompetencji położnych.',
    photo: 'magdalena-golba.jpg',
    objectPosition: 'center',
  },
  {
    name: 'Artur Gładosz',
    role: 'Fizjoterapeuta / MBA',
    desc: '20 lat praktyki klinicznej i zarządzania placówkami.',
    photo: 'artur-gladosz.png',
    objectPosition: 'center',
  },
];
---

<section id="o-nas" class="py-20 md:py-24 bg-paper">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
    <div class="text-center max-w-[720px] mx-auto mb-14">
      <div class="eyebrow center">Za projektem</div>
      <h2 class="font-heading text-[32px] md:text-[44px] mt-4 leading-tight tracking-tight text-ink">
        Stoją praktycy ochrony zdrowia
      </h2>
      <p class="text-[17px] md:text-[19px] leading-[1.6] mt-4 text-fg">
        Nasz zespół to medycy z wieloletnim doświadczeniem, którzy nadal pracują w ochronie zdrowia.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {team.map((member) => (
        <div>
          <div
            class="bg-ivory-2 overflow-hidden mb-5"
            style="aspect-ratio:3/4;border-radius:140px 140px 16px 16px;"
          >
            <img
              src={`${baseUrl}images/team/${member.photo}`}
              alt={member.name}
              class="w-full h-full object-cover"
              style={`object-position:${member.objectPosition};`}
            />
          </div>
          <h3 class="font-heading text-[20px] mb-1 text-ink">{member.name}</h3>
          <div class="text-[13px] font-semibold text-clay mb-3">{member.role}</div>
          <p class="text-[14.5px] leading-[1.55] text-fg">{member.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
