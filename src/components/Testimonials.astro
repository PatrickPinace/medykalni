---
// Testimonials — editorial cards na ivory-2 background
const reviews = [
  {
    quote: '„Szkolenie otworzyło mi oczy na wiele aspektów pracy z pacjentem. Prowadzący mówili językiem praktyków, a nie teoretyków."',
    initials: 'KN',
    name: 'Katarzyna Nowak',
    role: 'Pielęgniarka, Warszawa',
  },
  {
    quote: '„Dzięki wdrożeniu przez Medykalni zyskaliśmy przejrzyste procedury i lepszą organizację pracy. Personel wie, co i jak robić."',
    initials: 'PM',
    name: 'Piotr Malinowski',
    role: 'Właściciel gabinetu, Kraków',
  },
  {
    quote: '„Konsultacje 1:1 pomogły mi uporządkować podejście do prowadzenia praktyki. Wreszcie czuję, że kontroluję sytuację."',
    initials: 'AW',
    name: 'Agnieszka Wiśniewska',
    role: 'Lekarz rodzinny, Gdańsk',
  },
];
---

<section class="py-20 md:py-24 bg-ivory-2">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
    <div class="text-center max-w-[680px] mx-auto mb-14">
      <div class="eyebrow center">Opinie</div>
      <h2 class="font-heading text-[32px] md:text-[44px] mt-4 leading-tight tracking-tight text-ink">
        Co mówią uczestnicy
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-7">
      {reviews.map((review) => (
        <div class="bg-paper rounded-[20px] p-8 shadow-[0_10px_26px_rgba(35,32,28,0.09)]">
          <div class="flex gap-1 text-clay mb-4">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-[17px] h-[17px]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.37 1.12l1.07 3.29c.3.92-.75 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.17 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12l-2.8-2.03c-.79-.57-.39-1.81.58-1.81h3.46a1 1 0 00.95-.69l1.07-3.29z" />
              </svg>
            ))}
          </div>
          <p class="font-heading italic text-[17px] md:text-[18.5px] leading-[1.5] text-ink mb-6">
            {review.quote}
          </p>
          <div class="flex items-center gap-3.5">
            <div class="w-[46px] h-[46px] rounded-full bg-clay-soft text-clay font-heading text-[18px] flex items-center justify-center">
              {review.initials}
            </div>
            <div>
              <div class="font-heading text-[16px] text-ink">{review.name}</div>
              <div class="text-[13px] text-fg-soft">{review.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
