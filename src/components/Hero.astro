---
// Hero — Editorial Ciepły
const baseUrl = import.meta.env.BASE_URL;
---

<section class="py-20 md:py-24">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-12">
    <div class="grid md:grid-cols-[1.05fr_0.95fr] gap-10 md:gap-16 items-center">
      <!-- Lewa: treść -->
      <div>
        <div class="eyebrow">Szkolenia prowadzone przez praktyków</div>
        <h1 class="font-heading text-[44px] md:text-[52px] lg:text-[64px] leading-[1.1] tracking-tight my-6 text-ink">
          Opieka, która zaczyna się od <em>pewności</em> położnej
        </h1>
        <p class="text-[18px] md:text-[20px] leading-[1.6] max-w-[30em] text-fg">
          Praktyczna wiedza i wsparcie prowadzone przez praktyków ochrony zdrowia — bez teorii i motywacyjnych sloganów.
        </p>

        <div class="flex flex-wrap gap-3.5 mt-8">
          <a
            href={`${baseUrl}szkolenia/prowadzenie-ciazy-przez-polozna`}
            class="btn btn-navy"
          >
            Zobacz kurs
          </a>
          <a
            href={`${baseUrl}projekty`}
            class="btn btn-ghost"
          >
            Poznaj projekty
          </a>
        </div>

        <!-- Trust facts -->
        <div class="flex gap-9 mt-12 pt-8 border-t border-line">
          <div>
            <div class="font-heading text-[34px] text-navy leading-none">10+</div>
            <div class="text-[13.5px] text-fg-soft mt-2 leading-tight">lat praktyki<br>w ochronie zdrowia</div>
          </div>
          <div>
            <div class="font-heading text-[34px] text-navy leading-none">6</div>
            <div class="text-[13.5px] text-fg-soft mt-2 leading-tight">modułów<br>od diagnozy do porodu</div>
          </div>
          <div>
            <div class="font-heading text-[34px] text-navy leading-none">1:1</div>
            <div class="text-[13.5px] text-fg-soft mt-2 leading-tight">mentoring<br>i konsultacje</div>
          </div>
        </div>
      </div>

      <!-- Prawa: zdjęcie z łukiem + clay blob + badge -->
      <div class="relative">
        <!-- Clay blob za zdjęciem -->
        <div
          class="absolute -right-6 -bottom-6 w-[78%] h-[62%] bg-clay-soft z-0"
          style="border-radius:18px 18px 18px 120px;"
        ></div>

        <!-- Zdjęcie w łuku -->
        <div
          class="relative z-10 overflow-hidden shadow-[0_24px_50px_rgba(35,32,28,0.13)]"
          style="aspect-ratio:4/5;border-radius:200px 200px 18px 18px;"
        >
          <img
            src={`${baseUrl}images/team/medykalni-wszyscy.jpg`}
            alt="Zespół Medykalni"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Pływający badge -->
        <div class="absolute -left-4 md:-left-8 bottom-12 z-20 bg-paper rounded-2xl px-5 py-4 shadow-[0_10px_26px_rgba(35,32,28,0.09)] flex items-center gap-3 max-w-[230px]">
          <span class="w-[42px] h-[42px] rounded-full bg-teal text-white flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </span>
          <p class="text-[13px] text-ink font-semibold leading-tight">Materiały, certyfikat i zapis online w cenie</p>
        </div>
      </div>
    </div>
  </div>
</section>
